{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Deno",

  "name": "@wormblossom/simple-fs-deno",
  "version": "0.1.0",
  "exports": "./mod.ts",

  "imports": {
    "@std/assert": "jsr:@std/assert@^0.221.0",
    "@std/fs": "jsr:@std/fs@^1.0.18",
    "@std/path": "jsr:@std/path@^1.1.0",
    "@wormblossom/simple-fs-abstraction": "jsr:@wormblossom/simple-fs-abstraction@^0.1.0"
  },

  "compilerOptions": {
    "lib": ["deno.ns", "dom"],
    "strict": true
  },

  "tasks": {
    "test": "deno test --allow-read --allow-write test/tests.ts"
  }
}
